# ===========================================
# SUPABASE - Create a project at supabase.com
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# DEEPSEEK API
# ===========================================
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1

# ===========================================
# LEMONSQUEEZY
# ===========================================
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_STORE_ID=your-store-id
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret

# Product variant IDs (from the LemonSqueezy dashboard)
NEXT_PUBLIC_LEMONSQUEEZY_MONTHLY_VARIANT_ID=
NEXT_PUBLIC_LEMONSQUEEZY_UNLIMITED_VARIANT_ID=
NEXT_PUBLIC_LEMONSQUEEZY_EXPORT_VARIANT_ID=

# ===========================================
# SITE CONFIG
# ===========================================
NEXT_PUBLIC_SITE_URL=https://thesisgenerator.io
NEXT_PUBLIC_APP_URL=https://thesisgenerator.io
NEXT_PUBLIC_APP_NAME=Thesis Generator

# ===========================================
# EMAIL (Resend)
# ===========================================
RESEND_API_KEY=your-resend-key

# ===========================================
# CRON - shared secret for scheduled email endpoints
# (must match the CRON_SECRET set in your host + GitHub Actions secret)
# ===========================================
CRON_SECRET=generate-a-long-random-string

# ===========================================
# GITHUB - For blog automation
# ===========================================
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_REPO_OWNER=your-username
GITHUB_REPO_NAME=thesis-generator

# ===========================================
# OPTIONAL - Analytics & Marketing
# ===========================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
TIKTOK_ACCESS_TOKEN=
